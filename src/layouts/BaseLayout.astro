---
import '../styles/global.css';

const { title, description, currentPath = '/' } = Astro.props;
const canonical = Astro.url.origin + currentPath;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#080a0d" />
  <meta name="application-name" content="Malone Integrated Tech" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/malone_favicon_master.svg" />
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content="/malone_favicon_master.svg" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/malone_favicon_512.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="canonical" href={canonical} />
</head>
  <body>
    <div class="site-shell">
      <slot />
    </div>
  </body>
</html>
