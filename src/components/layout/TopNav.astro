---
import { withBase } from '../../lib/paths';

const homePath = withBase('/');
const whatWeBuildPath = `${homePath}#what-we-build`;
const howItWorksPath = `${homePath}#how-it-works`;
const researchPath = withBase('/research');
const proofPath = withBase('/projects');
const servicesPath = withBase('/services');
const contactPath = withBase('/contact');
const clientSignInPath = 'https://malone-client-operations-platform.vercel.app/login?next=%2Fclient';
---

<nav class="site-nav" aria-label="Primary navigation">
  <div class="site-nav__progress" aria-hidden="true"><span></span></div>
  <div class="section-shell site-nav__inner">
    <a href={homePath} class="site-nav__brand focus-visible">
      <img src={withBase('/brand/malone_mark_primary.svg')} class="site-nav__mark" alt="Malone Integrated Tech" />
      <img src={withBase('/brand/malone_lockup_horizontal_dark.png')} class="site-nav__lockup" alt="" />
    </a>
    <ul class="site-nav__links">
      <li><a href={whatWeBuildPath} data-nav-section="what-we-build">Capabilities</a></li>
      <li><a href={howItWorksPath} data-nav-section="how-it-works">Process</a></li>
      <li><a href={researchPath} data-nav-section="research">R&amp;D</a></li>
      <li><a href={proofPath} data-nav-section="proof">Current Work</a></li>
      <li><a href={servicesPath}>Services</a></li>
      <li><a href={clientSignInPath}>Client Sign In</a></li>
    </ul>
    <a href={contactPath} class="signal-button signal-button--small site-nav__cta" data-cta="nav_contact">
      Start a project <span aria-hidden="true">+</span>
    </a>
    <details class="site-nav__menu">
      <summary class="site-nav__menu-trigger" role="button" aria-controls="site-mobile-nav" aria-expanded="false" aria-label="Open navigation"><span></span><span></span></summary>
      <div class="site-nav__menu-panel" id="site-mobile-nav">
        <a href={whatWeBuildPath}>Capabilities</a>
        <a href={howItWorksPath}>Process</a>
        <a href={researchPath}>Research &amp; Development</a>
        <a href={proofPath}>Current Work</a>
        <a href={servicesPath}>Services</a>
        <a href={clientSignInPath}>Client Sign In</a>
        <a href={contactPath}>Start a project</a>
      </div>
    </details>
  </div>
</nav>

<script>
  const menus = document.querySelectorAll<HTMLDetailsElement>('.site-nav__menu');

  menus.forEach((menu) => {
    const trigger = menu.querySelector<HTMLElement>('.site-nav__menu-trigger');
    const sync = () => {
      const expanded = menu.open;
      trigger?.setAttribute('aria-expanded', String(expanded));
      trigger?.setAttribute('aria-label', expanded ? 'Close navigation' : 'Open navigation');
    };

    menu.addEventListener('toggle', sync);
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.open = false;
        sync();
      });
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      event.preventDefault();
      menu.open = false;
      sync();
      trigger?.focus();
    });
    sync();
  });
</script>
