<footer class="site-footer">
  <div class="section-shell site-footer__inner">
    <div class="site-footer__brand">
      <img src={withBase('/brand/malone_mark_monochrome_white.svg')} alt="" />
      <div>
        <p>Malone Integrated Tech</p>
        <span>Integrated assistant systems</span>
      </div>
    </div>
    <p class="site-footer__statement">ForgeMesh connects the pieces so complex systems are easier to use and work stays connected.</p>
    <div class="site-footer__meta">
      <a href="mailto:curtis@maloneintegratedtech.com">curtis@maloneintegratedtech.com</a>
      <nav class="site-footer__legal" aria-label="Legal">
        <a href={withBase('/privacy')}>Privacy</a>
        <a href={withBase('/terms')}>Terms</a>
      </nav>
      <span>(c) {new Date().getFullYear()} Malone Integrated Tech</span>
    </div>
  </div>
</footer>
