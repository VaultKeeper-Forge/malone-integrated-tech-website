---
import type { ResearchFocus } from '../../data/siteData';

interface Props {
  items: ResearchFocus[];
  researchPath: string;
}

const { items, researchPath } = Astro.props as Props;
---

<div class="research-teaser reveal">
  <div class="research-teaser__signal" aria-hidden="true"><span></span><i></i></div>
  <div class="research-teaser__copy">
    <p class="eyebrow">Deeper technical work</p>
    <h2>There is more machinery when the problem needs it.</h2>
    <p>We also research longer-term AI systems, continuity, ambient capture, and human-directed assistants.</p>
    <div class="research-teaser__topics" aria-label="Research topics">
      {items.map((item) => <span>{item.title}</span>)}
    </div>
  </div>
  <a class="text-link" href={researchPath}>Explore research <span aria-hidden="true">-&gt;</span></a>
</div>
