---
import type { ProofCase } from '../../data/siteData';
interface Props { items: ProofCase[]; }
const { items } = Astro.props as Props;
---

<div class="practice-grid">
  {items.map((item: ProofCase, index: number) => (
    <article class="practice-panel reveal tilt-surface" style={`--delay: ${index * 90}ms`}>
      <div class="practice-panel__topline">
        <span>Case frame / 0{index + 1}</span>
        <span class={`practice-panel__status practice-panel__status--${item.status}`}><i></i>{item.status}</span>
      </div>
      <h3>{item.title}</h3>
      <p>{item.summary}</p>
      <div class="practice-panel__note"><span>Current note</span><p>{item.outcome}</p></div>
      <div class="practice-panel__tags">{item.tags.map((tag: string) => <span>{tag}</span>)}</div>
      <span class="practice-panel__corner" aria-hidden="true"></span>
    </article>
  ))}
</div>
