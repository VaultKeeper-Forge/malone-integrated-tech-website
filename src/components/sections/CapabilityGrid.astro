---
import type { Capability } from '../../data/siteData';
interface ServiceLane extends Capability {
  prices?: { name: string; priceLabel: string }[];
}
interface Props { items: ServiceLane[]; }
const { items } = Astro.props as Props;
---

<div class="capability-system">
  <div class="capability-system__rail" aria-hidden="true"></div>
  {items.map((item: ServiceLane, index: number) => (
    <article class="capability-node reveal tilt-surface" style={`--delay: ${index * 90}ms`} data-service-lane={item.id}>
      <span class="panel-corner panel-corner--tl" aria-hidden="true"></span>
      <span class="panel-corner panel-corner--br" aria-hidden="true"></span>
      <header class="capability-node__header">
        <span class="capability-node__index">0{index + 1}</span>
        <span class="system-state"><i></i>{item.status}</span>
      </header>
      <div class={`capability-node__icon capability-node__icon--${index + 1}`} aria-hidden="true">
        {index === 0 && <svg viewBox="0 0 72 72"><path d="M12 22h17l7-8 7 8h17v28H43l-7 8-7-8H12z" /><path d="M20 30h32M20 42h32M36 22v28" /></svg>}
        {index === 1 && <svg viewBox="0 0 72 72"><circle cx="36" cy="24" r="10" /><path d="M18 58c2-13 9-20 18-20s16 7 18 20M8 36h11M53 36h11M13 31v10M59 31v10" /></svg>}
        {index === 2 && <svg viewBox="0 0 72 72"><circle cx="16" cy="20" r="5" /><circle cx="56" cy="18" r="5" /><circle cx="58" cy="54" r="5" /><circle cx="18" cy="55" r="5" /><circle cx="36" cy="36" r="8" /><path d="M21 22l9 9M51 22l-9 9M52 51l-10-9M22 51l9-9" /></svg>}
      </div>
      <h3>{item.title}</h3>
      <p>{item.description}</p>
      {item.prices && item.prices.length > 0 && (
        <p class="capability-node__prices" aria-label="Website starting prices">
          {item.prices.map((price) => <span><strong>{price.name}</strong>{price.priceLabel}</span>)}
        </p>
      )}
      <a class="capability-node__link" href={item.href}>{item.cta}<span aria-hidden="true">-&gt;</span></a>
      <div class="capability-node__signal" aria-hidden="true"><span></span></div>
    </article>
  ))}
</div>
