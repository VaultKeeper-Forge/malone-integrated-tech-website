---
import type { ProcessStep } from '../../data/siteData';
interface Props { steps: ProcessStep[]; }
const { steps } = Astro.props as Props;
---

<div class="process-system reveal" data-process-system>
  <div class="process-system__track" aria-hidden="true"><span></span></div>
  <ol>
    {steps.map((step: ProcessStep, index: number) => (
      <li class="process-stage" style={`--step-delay: ${index * 160}ms`}>
        <div class="process-stage__node" aria-hidden="true"><i></i><span>0{index + 1}</span></div>
        <div class="process-stage__copy"><p>{step.title}</p><span>{step.detail}</span></div>
      </li>
    ))}
  </ol>
  <div class="process-system__readout" aria-hidden="true"><span>Input</span><i></i><span>Sustained execution</span></div>
</div>
