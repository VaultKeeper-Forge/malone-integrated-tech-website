---
import { siteCopy } from '../../data/siteData';
import { withBase } from '../../lib/paths';

const servicesPath = withBase('/services');
const contactPath = withBase('/contact');
const markPath = withBase('/brand/malone_mark_primary.svg');
---

<div class="hero-banner reveal reveal-visible" data-cta="hero">
  <div class="hero-stage" data-hero-stage>
    <div class="hero-stage__grid" aria-hidden="true"></div>
    <div class="hero-stage__orbit hero-stage__orbit--outer" aria-hidden="true"></div>
    <div class="hero-stage__orbit hero-stage__orbit--inner" aria-hidden="true"></div>
    <div class="hero-stage__scan" aria-hidden="true"></div>
    <span class="lock-corner lock-corner--tl" aria-hidden="true"></span>
    <span class="lock-corner lock-corner--tr" aria-hidden="true"></span>
    <span class="lock-corner lock-corner--bl" aria-hidden="true"></span>
    <span class="lock-corner lock-corner--br" aria-hidden="true"></span>
    <span class="hero-stage__tick hero-stage__tick--left" aria-hidden="true"></span>
    <span class="hero-stage__tick hero-stage__tick--right" aria-hidden="true"></span>
    <div class="hero-stage__mark" aria-label="Malone Integrated Tech calibration mark">
      <img src={markPath} class="hero-stage__mark-shadow" alt="" />
      <img src={markPath} class="hero-stage__mark-depth" alt="" />
      <img src={markPath} class="hero-stage__mark-face" alt="" />
      <span class="hero-stage__glint" aria-hidden="true"></span>
    </div>
    <div class="hero-stage__base" aria-hidden="true"></div>
    <p class="hero-stage__status"><span></span> Systems aligned</p>
  </div>
  <div class="hero-copy">
    <div class="hero-copy__eyebrow">
      <span>{siteCopy.hero.eyebrow}</span>
    </div>
    <h1>{siteCopy.hero.line}</h1>
    <p class="hero-copy__detail">{siteCopy.hero.detail}</p>
    <p class="hero-copy__support">{siteCopy.hero.support}</p>
    <div class="hero-copy__actions">
      <a href={servicesPath} class="signal-button" data-cta="hero_primary">{siteCopy.hero.primaryAction} <span aria-hidden="true">+</span></a>
      <a href={contactPath} class="text-link" data-cta="hero_secondary">{siteCopy.hero.secondaryAction} <span aria-hidden="true">-&gt;</span></a>
    </div>
    <div class="hero-copy__principles" aria-label="How Malone works">
      {siteCopy.hero.principles.map((principle) => <span><i></i> {principle}</span>)}
    </div>
  </div>
  <a class="hero-scroll-cue" href="#services-paths" aria-label="Continue to services and starting prices">
    <span>Explore service paths</span><i aria-hidden="true"></i>
  </a>
</div>
