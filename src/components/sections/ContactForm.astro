---
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT?.trim() ?? '';
const endpointReady = /^https:\/\/script\.google\.com\/macros\/s\/[A-Za-z0-9_-]+\/exec$/.test(endpoint);
---

<div class="contact-form-frame reveal" data-contact-shell>
  <span class="lock-corner lock-corner--tl" aria-hidden="true"></span>
  <span class="lock-corner lock-corner--tr" aria-hidden="true"></span>
  <span class="lock-corner lock-corner--bl" aria-hidden="true"></span>
  <span class="lock-corner lock-corner--br" aria-hidden="true"></span>

  <header class="contact-form-frame__header">
    <div class="contact-form-frame__icon" aria-hidden="true">
      <svg viewBox="0 0 48 48">
        <path d="M7 12h34v24H7z" />
        <path d="m8 14 16 13 16-13M7 34l11-10M41 34 30 24" />
      </svg>
    </div>
    <div>
      <p class="eyebrow">Secure project intake</p>
      <h2>Route a message to Malone</h2>
    </div>
    <span class:list={['contact-channel-state', { 'is-ready': endpointReady }]}>
      <i></i>{endpointReady ? 'Channel ready' : 'Calibration pending'}
    </span>
  </header>

  <div class="contact-state-rail" data-state-rail data-state="input" aria-label="Submission progress">
    <span data-state-step="input"><i></i>Input locked</span>
    <b aria-hidden="true"></b>
    <span data-state-step="routing"><i></i>Message routed</span>
    <b aria-hidden="true"></b>
    <span data-state-step="confirmed"><i></i>Confirmed</span>
  </div>

  <form
    id="contact-form"
    class="contact-form"
    action={endpointReady ? endpoint : undefined}
    method="post"
    target="contact-transport"
    data-contact-form
    data-endpoint={endpoint}
    novalidate
  >
    <input type="hidden" name="formId" value="malone-contact-v1" />
    <input type="hidden" name="requestId" data-request-id />
    <input type="hidden" name="formStartedAt" data-started-at />

    <label class="contact-bot-trap" aria-hidden="true">
      <span>Website</span>
      <input name="website" tabindex="-1" autocomplete="off" />
    </label>

    <div class="contact-form__row">
      <label class="form-field">
        <span>Name <b>Required</b></span>
        <input name="name" autocomplete="name" required minlength="2" maxlength="120" />
        <small data-error-for="name"></small>
      </label>
      <label class="form-field">
        <span>Email <b>Required</b></span>
        <input type="email" name="email" autocomplete="email" required maxlength="254" inputmode="email" />
        <small data-error-for="email"></small>
      </label>
    </div>

    <div class="contact-form__row">
      <label class="form-field">
        <span>Business / organization <em>Optional</em></span>
        <input name="organization" autocomplete="organization" maxlength="160" />
        <small data-error-for="organization"></small>
      </label>
      <label class="form-field">
        <span>What can we help with? <b>Required</b></span>
        <select name="category" required>
          <option value="">Select a category</option>
          <option value="Local on-site IT support">Local on-site IT support</option>
          <option value="Computer / device help">Computer / device help</option>
          <option value="Website help">Website help</option>
          <option value="Business systems / automation / AI">Business systems / automation / AI</option>
          <option value="Not sure — help me figure it out">Not sure — help me figure it out</option>
        </select>
        <small data-error-for="category"></small>
      </label>
    </div>

    <label class="form-field form-field--message">
      <span>Message / question <b>Required</b></span>
      <textarea
        name="message"
        rows="8"
        required
        minlength="10"
        maxlength="5000"
        placeholder="Tell us what is not working together, what tools are involved, and what a useful outcome would look like."
      ></textarea>
      <small data-error-for="message"></small>
    </label>

    <div class="local-appointment-note" data-local-appointment-note hidden>
      <strong>This is an appointment request.</strong>
      <p>Include the service town or ZIP code, the equipment involved, and what is not working. Malone will confirm the service area, any travel charge, and an available arrival window before the visit.</p>
    </div>

    <label class="meeting-option" data-meeting-option>
      <input type="checkbox" name="meetingRequested" value="yes" />
      <span class="meeting-option__control" aria-hidden="true"><i></i></span>
      <span class="meeting-option__icon" aria-hidden="true">
        <svg viewBox="0 0 40 40">
          <path d="M8 11h24v22H8zM8 17h24M14 7v8M26 7v8" />
          <path d="M14 22h4v4h-4zM22 22h4v4h-4z" />
        </svg>
      </span>
      <span>
        <strong>I would like to schedule an online discovery meeting.</strong>
        <small>You will choose an available appointment after this message is confirmed.</small>
      </span>
    </label>

    <div class="contact-form__footer">
      <button type="submit" class="signal-button contact-submit" data-submit-button>
        <b data-submit-label>Route message</b><span aria-hidden="true">+</span>
      </button>
      <p>Messages are emailed directly. Raw form submissions are not retained by the website.</p>
    </div>

    <div class="contact-form__status" data-form-status role="status" aria-live="polite"></div>
  </form>

  <section class="submission-confirmation" data-confirmation hidden aria-live="polite">
    <div class="submission-confirmation__mark" aria-hidden="true"><i></i></div>
    <div>
      <p class="eyebrow">Message confirmed</p>
      <h3>We received your message.</h3>
      <p>A confirmation copy has been routed to <strong data-confirmation-email></strong>.</p>
      <blockquote data-confirmation-message></blockquote>
      <a class="signal-button submission-confirmation__booking" data-booking-button hidden>
        Schedule your discovery meeting <span aria-hidden="true">-&gt;</span>
      </a>
      <button type="button" class="text-link submission-confirmation__reset" data-send-another>
        Send another message <span aria-hidden="true">+</span>
      </button>
    </div>
  </section>

  <iframe
    name="contact-transport"
    class="contact-transport"
    data-contact-transport
    title="Contact submission transport"
    tabindex="-1"
    aria-hidden="true"
  ></iframe>

  <script>
    const shell = document.querySelector('[data-contact-shell]') as HTMLElement | null;
    const form = shell?.querySelector('[data-contact-form]') as HTMLFormElement | null;
    const transport = shell?.querySelector('[data-contact-transport]') as HTMLIFrameElement | null;
    const stateRail = shell?.querySelector('[data-state-rail]') as HTMLElement | null;
    const status = shell?.querySelector('[data-form-status]') as HTMLElement | null;
    const submitButton = shell?.querySelector('[data-submit-button]') as HTMLButtonElement | null;
    const submitLabel = shell?.querySelector('[data-submit-label]') as HTMLElement | null;
    const confirmation = shell?.querySelector('[data-confirmation]') as HTMLElement | null;
    const bookingButton = shell?.querySelector('[data-booking-button]') as HTMLAnchorElement | null;
    const sendAnother = shell?.querySelector('[data-send-another]') as HTMLButtonElement | null;
    const category = form?.elements.namedItem('category') as HTMLSelectElement | null;
    const messageField = form?.elements.namedItem('message') as HTMLTextAreaElement | null;
    const meetingOption = shell?.querySelector('[data-meeting-option]') as HTMLLabelElement | null;
    const meetingRequested = form?.elements.namedItem('meetingRequested') as HTMLInputElement | null;
    const localAppointmentNote = shell?.querySelector('[data-local-appointment-note]') as HTMLElement | null;
    const defaultMessagePlaceholder = messageField?.placeholder ?? '';
    const localSupportCategory = 'Local on-site IT support';
    const isAllowedMessageOrigin = (origin: string) => {
      try {
        const source = new URL(origin);
        return source.protocol === 'https:' &&
          (source.hostname === 'script.google.com' ||
            source.hostname.endsWith('-script.googleusercontent.com'));
      } catch {
        return false;
      }
    };

    let pendingSubmission: {
      requestId: string;
      email: string;
      message: string;
      meetingRequested: boolean;
    } | null = null;
    let responseTimer = 0;

    const makeRequestId = () =>
      globalThis.crypto?.randomUUID?.() ??
      `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}-${Math.random().toString(36).slice(2)}`;

    const resetEnvelope = () => {
      const requestId = form?.querySelector('[data-request-id]') as HTMLInputElement | null;
      const startedAt = form?.querySelector('[data-started-at]') as HTMLInputElement | null;
      if (requestId) requestId.value = makeRequestId();
      if (startedAt) startedAt.value = String(Date.now());
    };

    const syncIntakeMode = () => {
      const isLocalAppointment = category?.value === localSupportCategory;
      if (localAppointmentNote) localAppointmentNote.hidden = !isLocalAppointment;
      if (meetingOption) meetingOption.hidden = isLocalAppointment;
      if (meetingRequested) {
        if (isLocalAppointment) meetingRequested.checked = false;
        meetingRequested.disabled = isLocalAppointment;
      }
      if (messageField) {
        messageField.placeholder = isLocalAppointment
          ? 'Tell us your town or ZIP code, what equipment is involved, what is not working, and the appointment times that usually work for you.'
          : defaultMessagePlaceholder;
      }
    };

    const setState = (next: 'input' | 'routing' | 'confirmed' | 'error', message = '') => {
      if (stateRail) stateRail.dataset.state = next;
      if (status) {
        status.dataset.kind = next;
        status.textContent = message;
      }
      if (submitButton) {
        submitButton.disabled = next === 'routing';
        submitButton.setAttribute('aria-busy', String(next === 'routing'));
      }
      if (submitLabel) {
        submitLabel.textContent = next === 'routing' ? 'Routing message' : 'Route message';
      }
    };

    const errorFor = (field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement, message: string) => {
      field.setAttribute('aria-invalid', String(Boolean(message)));
      const error = form?.querySelector(`[data-error-for="${field.name}"]`) as HTMLElement | null;
      if (error) error.textContent = message;
      return Boolean(message);
    };

    const validateForm = () => {
      if (!form) return false;
      const name = form.elements.namedItem('name') as HTMLInputElement;
      const email = form.elements.namedItem('email') as HTMLInputElement;
      const organization = form.elements.namedItem('organization') as HTMLInputElement;
      const category = form.elements.namedItem('category') as HTMLSelectElement;
      const message = form.elements.namedItem('message') as HTMLTextAreaElement;

      const failures = [
        [name, name.value.trim().length < 2 ? 'Enter your name.' : ''],
        [email, !email.validity.valid || !email.value.trim() ? 'Enter a valid email address.' : ''],
        [organization, organization.value.trim().length > 160 ? 'Keep the organization under 160 characters.' : ''],
        [category, !category.value ? 'Choose the closest category.' : ''],
        [message, message.value.trim().length < 10 ? 'Add at least 10 characters so we can understand the request.' : '']
      ] as const;

      const firstFailure = failures.find(([, error]) => Boolean(error));
      failures.forEach(([field, error]) => errorFor(field, error));
      firstFailure?.[0].focus();
      return !firstFailure;
    };

    form?.querySelectorAll('input, select, textarea').forEach((field) => {
      field.addEventListener('input', () => {
        if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement) {
          errorFor(field, '');
        }
      });
    });

    category?.addEventListener('change', syncIntakeMode);

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form || !validateForm()) {
        setState('error', 'Check the highlighted fields and try again.');
        return;
      }

      const endpoint = form.dataset.endpoint?.trim() ?? '';
      if (!/^https:\/\/script\.google\.com\/macros\/s\/[A-Za-z0-9_-]+\/exec$/.test(endpoint)) {
        setState('error', 'Secure message routing is not active yet. Please use the email path beside this form.');
        return;
      }

      const data = new FormData(form);
      pendingSubmission = {
        requestId: String(data.get('requestId') ?? ''),
        email: String(data.get('email') ?? '').trim(),
        message: String(data.get('message') ?? '').trim(),
        meetingRequested: data.get('meetingRequested') === 'yes'
      };

      setState('routing', 'Input locked. Routing your message now.');
      window.clearTimeout(responseTimer);
      responseTimer = window.setTimeout(() => {
        setState('error', 'The message route did not confirm in time. Your form is still here, so you can try again.');
      }, 15000);

      window.setTimeout(() => {
        if (status) status.textContent = 'Message routed. Waiting for confirmation.';
      }, 180);

      form.submit();
    });

    window.addEventListener('message', (event) => {
      if (!transport?.contentWindow || !isAllowedMessageOrigin(event.origin)) return;
      const result = event.data as {
        type?: string;
        requestId?: string;
        ok?: boolean;
        message?: string;
        bookingUrl?: string;
      };
      if (result?.type !== 'malone-contact-result') return;
      if (!pendingSubmission || result.requestId !== pendingSubmission.requestId) return;

      window.clearTimeout(responseTimer);

      if (!result.ok || !form) {
        setState('error', result.message || 'The message could not be confirmed. Please try again.');
        return;
      }

      setState('confirmed', 'Message confirmed. A copy is on its way to your inbox.');
      form.hidden = true;
      if (confirmation) confirmation.hidden = false;

      const emailTarget = confirmation?.querySelector('[data-confirmation-email]');
      const messageTarget = confirmation?.querySelector('[data-confirmation-message]');
      if (emailTarget) emailTarget.textContent = pendingSubmission.email;
      if (messageTarget) messageTarget.textContent = pendingSubmission.message;

      if (bookingButton) {
        bookingButton.hidden = true;
        bookingButton.removeAttribute('href');
        if (pendingSubmission.meetingRequested && result.bookingUrl) {
          try {
            const booking = new URL(result.bookingUrl);
            const allowedBooking =
              booking.protocol === 'https:' &&
              (booking.hostname === 'calendar.app.google' ||
                booking.hostname === 'calendar.google.com' ||
                booking.hostname.endsWith('.google.com'));
            if (allowedBooking) {
              bookingButton.href = booking.toString();
              bookingButton.target = '_blank';
              bookingButton.rel = 'noopener noreferrer';
              bookingButton.hidden = false;
            }
          } catch {
            bookingButton.hidden = true;
          }
        }
      }

      form.reset();
      syncIntakeMode();
      resetEnvelope();
    });

    sendAnother?.addEventListener('click', () => {
      if (confirmation) confirmation.hidden = true;
      if (form) form.hidden = false;
      pendingSubmission = null;
      setState('input', '');
      syncIntakeMode();
      resetEnvelope();
      (form?.elements.namedItem('name') as HTMLInputElement | null)?.focus();
    });

    const requestedCategory = new URLSearchParams(window.location.search).get('category');
    if (category && requestedCategory === 'local-onsite-support') {
      category.value = localSupportCategory;
    }
    syncIntakeMode();
    resetEnvelope();
  </script>
</div>
