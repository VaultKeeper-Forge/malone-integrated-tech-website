---
interface PricingItem {
  id: string;
  name: string;
  priceLabel: string;
  summary: string;
}

interface Props {
  items: PricingItem[];
  servicesPath: string;
}

const { items, servicesPath } = Astro.props as Props;
---

<div class="pricing-snapshot reveal" data-home-pricing>
  <div class="pricing-snapshot__grid">
    {items.map((item) => (
      <article data-home-price={item.id}>
        <div>
          <h3>{item.name}</h3>
          <p>{item.summary}</p>
        </div>
        <strong>{item.priceLabel}</strong>
      </article>
    ))}
  </div>
  <div class="pricing-snapshot__footer">
    <p>Practical planning numbers, confirmed in writing before implementation begins.</p>
    <a class="text-link" href={servicesPath}>See all services &amp; starting prices <span aria-hidden="true">-&gt;</span></a>
  </div>
</div>
