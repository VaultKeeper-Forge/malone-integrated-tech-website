---
const { number = '00', title, heading, mobileHeading = '', description = '', level = 2 } = Astro.props;
---

<header class="section-heading reveal">
  <div class="section-heading__rail" aria-hidden="true"><span>{number}</span><i></i></div>
  <div class="section-heading__copy">
    <p class="eyebrow">{title}</p>
    {level === 1
      ? <h1 class:list={['section-title', { 'section-title--responsive': mobileHeading }]}>
          <span class="section-title__desktop">{heading}</span>
          {mobileHeading && <span class="section-title__mobile">{mobileHeading}</span>}
        </h1>
      : <h2 class:list={['section-title', { 'section-title--responsive': mobileHeading }]}>
          <span class="section-title__desktop">{heading}</span>
          {mobileHeading && <span class="section-title__mobile">{mobileHeading}</span>}
        </h2>}
    {description && <p class="section-subtitle">{description}</p>}
  </div>
</header>
