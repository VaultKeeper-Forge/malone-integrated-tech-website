---
import { withBase } from '../../lib/paths';
---

<div class="contact-desk reveal">
  <span class="lock-corner lock-corner--tl" aria-hidden="true"></span>
  <span class="lock-corner lock-corner--tr" aria-hidden="true"></span>
  <span class="lock-corner lock-corner--bl" aria-hidden="true"></span>
  <span class="lock-corner lock-corner--br" aria-hidden="true"></span>
  <div class="contact-desk__signal" aria-hidden="true"><div><span></span></div><p>Channel open</p></div>
  <div class="contact-desk__copy">
    <p class="eyebrow">Start a conversation</p>
    <h2>Have a system that is not working together?</h2>
    <p>Let us map the friction, align the tools, and define a practical path from scattered signals to sustained execution.</p>
  </div>
  <div class="contact-desk__actions">
    <a href={withBase('/contact')} class="signal-button" data-cta="cta_contact">Map your system <span aria-hidden="true">+</span></a>
    <a href="mailto:curtis@maloneintegratedtech.com" class="text-link">curtis@maloneintegratedtech.com</a>
  </div>
</div>
