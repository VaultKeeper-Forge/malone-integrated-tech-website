---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNav from '../../components/layout/TopNav.astro';
import Footer from '../../components/layout/Footer.astro';
import SectionHeading from '../../components/sections/SectionHeading.astro';
import { siteCopy } from '../../data/siteData';
---

<BaseLayout
  title="Research | Malone Integrated Tech"
  description="Research priorities: wearable AI, ambient capture, continuity, and long-term human-AI interaction."
  currentPath="/research"
>
  <TopNav />
  <main class="section-shell page-main">
    <SectionHeading
      level={1}
      title="Research & Development"
      heading="Research with explicit controls"
      description="We separate exploratory programs from production systems and mark readiness by phase."
    />
    <div class="content-card-grid content-card-grid--two">
      {siteCopy.research.map((topic) => (
        <article class="card-panel reveal">
          <p class="chip">Phase: {topic.status}</p>
          <h2 class="detail-card__title detail-card__title--tight">{topic.title}</h2>
          <p class="detail-card__summary">{topic.summary}</p>
          <ul class="detail-card__list detail-card__list--tight">
            {topic.constraints.map((constraint) => (
              <li class="detail-card__item">
                <span class="detail-card__bullet"></span>
                {constraint}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>

