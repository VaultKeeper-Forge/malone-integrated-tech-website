---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNav from '../../components/layout/TopNav.astro';
import Footer from '../../components/layout/Footer.astro';
import ServiceOfferCard from '../../components/services/ServiceOfferCard.astro';
import { withBase } from '../../lib/paths';
import {
  buyingTerms,
  carePlans,
  serviceAddOns,
  serviceCategories
} from '../../data/serviceData';
---

<BaseLayout
  title="Small Business Technology Services | Malone Integrated Tech"
  description="Clear starting prices for websites, connected offices, workflow automation, AI assistants, secure client portals, and ongoing systems care."
  currentPath="/services"
>
  <TopNav />
  <main class="services-page">
    <section class="section-shell services-hero" aria-labelledby="services-title">
      <div class="services-hero__copy">
        <p class="eyebrow">Services &amp; starting prices</p>
        <h1 id="services-title">Useful systems, clearly scoped.</h1>
        <p class="services-hero__lead">
          Start small, solve the right problem, and expand only when the next layer earns its place.
          These prices are practical planning numbers—not bait for a mystery sales call.
        </p>
        <div class="services-hero__actions">
          <a href={withBase('/contact')} class="signal-button" data-cta="services_fit_check">
            Request a fit check <span aria-hidden="true">+</span>
          </a>
          <a href="#start" class="text-link">See the options <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <aside class="services-hero__readout" aria-label="How Malone engagements work">
        <p class="services-hero__readout-label">Every engagement</p>
        <ul>
          <li><span>01</span><p><strong>Written scope</strong> before implementation begins</p></li>
          <li><span>02</span><p><strong>Visible checkpoints</strong> before consequential changes</p></li>
          <li><span>03</span><p><strong>Owner-held accounts</strong> instead of vendor lock-in</p></li>
          <li><span>04</span><p><strong>Practical handoff</strong> with the operating notes you need</p></li>
        </ul>
      </aside>
    </section>

    <nav class="section-shell services-jump" aria-label="Service categories">
      <p>Jump to</p>
      {serviceCategories.map((category) => <a href={`#${category.id}`}>{category.eyebrow}</a>)}
      <a href="#care">Ongoing care</a>
      <a href="#terms">Buying terms</a>
    </nav>

    {serviceCategories.map((category, categoryIndex) => (
      <section class="section-shell service-category" id={category.id} aria-labelledby={`${category.id}-title`}>
        <header class="service-category__header">
          <div class="service-category__number" aria-hidden="true">
            <span>{String(categoryIndex + 1).padStart(2, '0')}</span><i></i>
          </div>
          <div>
            <p class="eyebrow">{category.eyebrow}</p>
            <h2 id={`${category.id}-title`}>{category.title}</h2>
            <p>{category.summary}</p>
          </div>
        </header>
        <div class="service-offer-grid">
          {category.offers.map((offer, index) => <ServiceOfferCard offer={offer} index={index} />)}
        </div>
      </section>
    ))}

    <section class="services-care" id="care" aria-labelledby="care-title">
      <div class="section-shell">
        <header class="services-care__header">
          <div>
            <p class="eyebrow">Ongoing care</p>
            <h2 id="care-title">Keep the system useful after launch</h2>
          </div>
          <p>
            Care plans are optional and month-to-month after the initial build. They cover defined
            maintenance—not unlimited redesign or new development.
          </p>
        </header>
        <div class="care-plan-grid">
          {carePlans.map((plan) => (
            <article class="care-plan" data-care-plan={plan.id}>
              <p class="care-plan__price">{plan.priceLabel}</p>
              <h3>{plan.name}</h3>
              <p class="care-plan__summary">{plan.summary}</p>
              <ul>{plan.includes.map((item) => <li>{item}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-shell services-addons" aria-labelledby="addons-title">
      <header class="services-addons__header">
        <div>
          <p class="eyebrow">Common additions</p>
          <h2 id="addons-title">Add only what the job actually needs</h2>
        </div>
        <p>These can be attached to a project when they fit the approved scope.</p>
      </header>
      <div class="services-addons__list">
        {serviceAddOns.map((addOn) => (
          <article>
            <div>
              <h3>{addOn.name}</h3>
              <p>{addOn.detail}</p>
            </div>
            <strong>{addOn.priceLabel}</strong>
          </article>
        ))}
      </div>
    </section>

    <section class="section-shell services-terms" id="terms" aria-labelledby="terms-title">
      <div class="services-terms__copy">
        <p class="eyebrow">Straightforward buying terms</p>
        <h2 id="terms-title">No surprise meter running in the background</h2>
        <p>
          A proposal turns the planning price into an exact scope. If the job changes, the price
          changes only after the new work is described and approved.
        </p>
      </div>
      <ol>
        {buyingTerms.map((term, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span><p>{term}</p></li>
        ))}
      </ol>
    </section>

    <section class="section-shell services-cta" aria-labelledby="services-cta-title">
      <div>
        <p class="eyebrow">Start with the problem</p>
        <h2 id="services-cta-title">Not sure which package fits?</h2>
        <p>Tell us what is frustrating, slow, disconnected, or newly possible. We will identify the smallest useful next move.</p>
      </div>
      <a href={withBase('/contact')} class="signal-button" data-cta="services_contact">
        Start a conversation <span aria-hidden="true">+</span>
      </a>
    </section>
  </main>
  <Footer />
</BaseLayout>
