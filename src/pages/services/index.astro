---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNav from '../../components/layout/TopNav.astro';
import Footer from '../../components/layout/Footer.astro';
import SectionHeading from '../../components/sections/SectionHeading.astro';
import { siteCopy } from '../../data/siteData';
---

<BaseLayout
  title="Services | Malone Integrated Tech"
  description="Service tracks for practical AI systems integration and continuity-focused delivery."
  currentPath="/services"
>
  <TopNav />
  <main class="section-shell page-main">
    <SectionHeading
      level={1}
      title="Services"
      heading="Implementation tracks tuned to small teams"
      description="Clear ownership and review points for each delivery stage."
    />
    <div class="content-card-grid content-card-grid--three">
      {siteCopy.services.map((service) => (
        <article class="card-panel reveal">
          <p class="chip">Cadence: {service.cadence}</p>
          <h2 class="detail-card__title">{service.title}</h2>
          <p class="detail-card__summary">{service.summary}</p>
          <ul class="detail-card__list">
            {service.deliverables.map((deliverable) => (
              <li class="detail-card__item">
                <span class="detail-card__bullet"></span>
                {deliverable}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>

