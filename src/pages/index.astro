---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from '../components/layout/TopNav.astro';
import Footer from '../components/layout/Footer.astro';
import SectionHeading from '../components/sections/SectionHeading.astro';
import HeroBanner from '../components/sections/HeroBanner.astro';
import CapabilityGrid from '../components/sections/CapabilityGrid.astro';
import PricingSnapshot from '../components/sections/PricingSnapshot.astro';
import ProcessSection from '../components/sections/ProcessSection.astro';
import ContactCTA from '../components/sections/ContactCTA.astro';
import ResearchTeaser from '../components/sections/ResearchTeaser.astro';
import FeaturedWorkFeature from '../components/ui/FeaturedWorkFeature.astro';
import { featuredWork, siteCopy } from '../data/siteData';
import { allPublicOffers, carePlans } from '../data/serviceData';
import { withBase } from '../lib/paths';

const requireOffer = (id: string) => {
  const offer = allPublicOffers.find((candidate) => candidate.id === id);
  if (!offer) throw new Error(`Missing homepage service offer: ${id}`);
  return offer;
};

const requireCarePlan = (id: string) => {
  const plan = carePlans.find((candidate) => candidate.id === id);
  if (!plan) throw new Error(`Missing homepage care plan: ${id}`);
  return plan;
};

const serviceLanes = siteCopy.capabilities.map((lane) => ({
  ...lane,
  href: withBase(lane.href),
  prices: lane.priceOfferIds?.map((id) => {
    const offer = requireOffer(id);
    return { name: offer.name, priceLabel: offer.priceLabel };
  })
}));

const pricingItems = [
  ...[
    'fit-check',
    'systems-map',
    'digital-front-door',
    'connected-business-website',
    'workflow-automation'
  ].map(requireOffer),
  requireCarePlan('site-care')
];
---

<BaseLayout
  title="Websites, IT Help & Business Technology | Malone Integrated Tech"
  description="Malone Integrated Tech builds small-business websites, fixes technology problems, connects tools, and creates practical automation and AI assistants in Northern California."
  currentPath="/"
>
  <TopNav />

  <main class="ultra-main">
    <div class="ambient-field ambient-field--one" aria-hidden="true"></div>
    <div class="ambient-field ambient-field--two" aria-hidden="true"></div>

    <section class="section-shell hero-section" data-section="hero">
      <HeroBanner />
    </section>

    <section id="what-we-build" class="section-shell ultra-section" data-section="what-we-build">
      <SectionHeading
        number="01"
        title="How we can help"
        heading="Start with the problem you already recognize"
        description="Choose the lane that sounds closest. We can sort out the technical details together."
      />
      <CapabilityGrid items={serviceLanes} />
    </section>

    <section id="pricing" class="section-shell ultra-section ultra-section--compact" data-section="pricing">
      <SectionHeading
        number="02"
        title="Starting prices"
        heading="Clear numbers before a mystery sales call"
        description="A short planning snapshot from the same service catalog used on the full Services page."
      />
      <PricingSnapshot items={pricingItems} servicesPath={withBase('/services')} />
    </section>

    <section id="systems-in-practice" class="section-shell ultra-section ultra-section--proof" data-section="systems-in-practice">
      <SectionHeading
        number="03"
        title="Real work"
        heading="See what Malone is building and operating"
        description="One active client website and one owner-operated production system, each labeled honestly."
      />
      <div class="featured-work-stack">
        <FeaturedWorkFeature work={featuredWork[0]} compact />
        <FeaturedWorkFeature work={featuredWork[1]} compact />
      </div>
    </section>

    <section id="how-it-works" class="section-shell ultra-section ultra-section--process" data-section="how-it-works">
      <SectionHeading
        number="04"
        title="How Malone works"
        heading="Three steps from problem to useful handoff"
        mobileHeading="Three useful steps"
        description="The deeper engineering is still here. You just do not have to learn it before we can help."
      />
      <ProcessSection steps={siteCopy.process} />
    </section>

    <section id="contact" class="section-shell ultra-section ultra-section--contact" data-section="contact">
      <ContactCTA />
    </section>

    <section id="research" class="section-shell ultra-section ultra-section--research-teaser" data-section="research">
      <ResearchTeaser items={siteCopy.research} researchPath={withBase('/research')} />
    </section>
  </main>

  <Footer />

  <script is:inline>
    document.documentElement.classList.add('motion-ready');

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealNodes = document.querySelectorAll('.reveal');

    if (reduced || !('IntersectionObserver' in window)) {
      revealNodes.forEach((node) => node.classList.add('reveal-visible'));
    } else {
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('reveal-visible');
          if (entry.target.hasAttribute('data-process-system')) {
            entry.target.classList.add('is-running');
          }
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.16, rootMargin: '0px 0px -8% 0px' });

      revealNodes.forEach((node) => revealObserver.observe(node));
    }

    const navLinks = Array.from(document.querySelectorAll('[data-nav-section]'));
    const sections = Array.from(document.querySelectorAll('[data-section]')).filter((section) => section.id);

    if ('IntersectionObserver' in window) {
      const sectionObserver = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        navLinks.forEach((link) => {
          link.classList.toggle('is-active', link.getAttribute('data-nav-section') === visible.target.id);
        });
      }, { threshold: [0.18, 0.35, 0.55], rootMargin: '-18% 0px -54% 0px' });
      sections.forEach((section) => sectionObserver.observe(section));
    }

    const root = document.documentElement;
    let scrollFrame = 0;
    const updateScroll = () => {
      scrollFrame = 0;
      const scrollable = Math.max(1, root.scrollHeight - window.innerHeight);
      root.style.setProperty('--page-progress', String(Math.min(1, window.scrollY / scrollable)));
    };
    window.addEventListener('scroll', () => {
      if (!scrollFrame) scrollFrame = requestAnimationFrame(updateScroll);
    }, { passive: true });
    updateScroll();

    if (!reduced) {
      const heroStage = document.querySelector('[data-hero-stage]');
      if (heroStage instanceof HTMLElement) {
        heroStage.addEventListener('pointermove', (event) => {
          const rect = heroStage.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width;
          const y = (event.clientY - rect.top) / rect.height;
          heroStage.style.setProperty('--ry', `${(x - 0.5) * 24}deg`);
          heroStage.style.setProperty('--rx', `${(0.5 - y) * 20}deg`);
          heroStage.style.setProperty('--mx', `${x * 100}%`);
          heroStage.style.setProperty('--my', `${y * 100}%`);
        });
        heroStage.addEventListener('pointerleave', () => {
          heroStage.style.setProperty('--ry', '0deg');
          heroStage.style.setProperty('--rx', '0deg');
          heroStage.style.setProperty('--mx', '50%');
          heroStage.style.setProperty('--my', '45%');
        });
      }

      document.querySelectorAll('.tilt-surface').forEach((surface) => {
        if (!(surface instanceof HTMLElement)) return;
        surface.addEventListener('pointermove', (event) => {
          const rect = surface.getBoundingClientRect();
          surface.style.setProperty('--glow-x', `${event.clientX - rect.left}px`);
          surface.style.setProperty('--glow-y', `${event.clientY - rect.top}px`);
        });
      });
    }

    document.querySelectorAll('.site-nav__menu-panel a').forEach((link) => {
      link.addEventListener('click', () => {
        const menu = link.closest('details');
        if (menu) menu.removeAttribute('open');
      });
    });
  </script>
</BaseLayout>
