---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from '../components/layout/TopNav.astro';
import Footer from '../components/layout/Footer.astro';
import SectionHeading from '../components/sections/SectionHeading.astro';
import HeroBanner from '../components/sections/HeroBanner.astro';
import CapabilityGrid from '../components/sections/CapabilityGrid.astro';
import ProcessSection from '../components/sections/ProcessSection.astro';
import ContactCTA from '../components/sections/ContactCTA.astro';
import {
  homepageClientSteps,
  homepageOutcomes,
  homepageServicePaths,
  siteCopy
} from '../data/siteData';
import { withBase } from '../lib/paths';

const servicesPath = withBase('/services');
const projectsPath = withBase('/projects');
---

<BaseLayout
  title="Technology Help & Small Business Systems | Malone Integrated Tech"
  description="Malone Integrated Tech provides local technology help and builds connected websites, workflows, and assistant systems for homes and small businesses."
  currentPath="/"
>
  <TopNav />

  <main class="ultra-main">
    <div class="ambient-field ambient-field--one" aria-hidden="true"></div>
    <div class="ambient-field ambient-field--two" aria-hidden="true"></div>

    <section class="section-shell hero-section" data-section="hero">
      <HeroBanner />
    </section>

    <section id="services-paths" class="section-shell ultra-section customer-section" data-section="services-paths">
      <SectionHeading
        number="01"
        title="Services & Starting Prices"
        heading="Start with the smallest useful move"
        description="Choose local hands-on help, define the right first step, or build a connected system around the work that needs to move."
      />
      <div class="homepage-paths">
        {homepageServicePaths.map((path, index) => (
          <article
            class="homepage-path reveal"
            data-home-service-path={path.id}
            data-source-offer-ids={path.sourceOfferIds.join(',')}
            style={`--delay: ${index * 80}ms`}
          >
            <span class="panel-corner panel-corner--tl" aria-hidden="true"></span>
            <span class="panel-corner panel-corner--br" aria-hidden="true"></span>
            <span class="homepage-path__index">0{index + 1}</span>
            <h3>{path.title}</h3>
            <p class="homepage-path__price" data-home-service-price>{path.priceLabel}</p>
            <p>{path.meaning}</p>
          </article>
        ))}
      </div>
      <div class="homepage-route reveal">
        <a href={servicesPath} class="text-link" data-cta="homepage_services">
          Compare all services and prices <span aria-hidden="true">-&gt;</span>
        </a>
      </div>
    </section>

    <section id="customer-outcomes" class="section-shell ultra-section customer-section" data-section="customer-outcomes">
      <SectionHeading
        number="02"
        title="Customer Outcomes"
        heading="Less searching. Fewer broken handoffs. Clearer ownership."
        description="The goal is practical: make important work easier to find, move, review, and hand off."
      />
      <div class="outcome-grid">
        {homepageOutcomes.map((outcome, index) => (
          <article class="outcome-card reveal" style={`--delay: ${index * 80}ms`}>
            <span class="outcome-card__index">0{index + 1}</span>
            <h3>{outcome.title}</h3>
            <p>{outcome.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="working-with-malone" class="section-shell ultra-section customer-section" data-section="working-with-malone">
      <SectionHeading
        number="03"
        title="Working Together"
        heading="How clients work with Malone"
        description="The work stays understandable from the first problem through the final handoff."
      />
      <ol class="client-step-grid">
        {homepageClientSteps.map((step, index) => (
          <li class="client-step reveal" style={`--delay: ${index * 70}ms`}>
            <span class="client-step__index">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="projects-proof" class="section-shell ultra-section ultra-section--compact" data-section="projects-proof">
      <article class="proof-route reveal">
        <span class="panel-corner panel-corner--tl" aria-hidden="true"></span>
        <span class="panel-corner panel-corner--br" aria-hidden="true"></span>
        <div>
          <p class="eyebrow">Projects & Proof</p>
          <h2>See current work and honest project status</h2>
          <p>Live client work, pilots, and research are labeled separately so you can see what is active, what is being tested, and what remains exploratory.</p>
        </div>
        <a href={projectsPath} class="signal-button" data-cta="homepage_projects">
          View projects & proof <span aria-hidden="true">+</span>
        </a>
      </article>
    </section>

    <section id="what-we-build" class="section-shell ultra-section" data-section="what-we-build">
      <SectionHeading
        number="05"
        title="What We Build"
        heading="Capabilities engineered for real workflows"
        description="No generic assistant layer. We build systems around how people and small teams already work, then make the connections durable."
      />
      <CapabilityGrid items={siteCopy.capabilities} />
    </section>

    <section id="how-it-works" class="section-shell ultra-section ultra-section--process" data-section="how-it-works">
      <SectionHeading
        number="06"
        title="How It Works"
        heading="How the system moves"
        mobileHeading="How the system moves"
        description="A controlled signal path from raw input to useful work that stays coherent over time."
      />
      <ProcessSection steps={siteCopy.process} />
    </section>

    <section id="research" class="section-shell ultra-section" data-section="research">
      <SectionHeading
        number="07"
        title="Research & Development"
        heading="Research with engineering discipline"
        description="Focused investigation into how assistants can stay present, useful, and accountable across longer human relationships."
      />
      <div class="research-system reveal">
        <div class="research-system__circuit" aria-hidden="true"><span></span><i></i></div>
        {siteCopy.research.map((item, index) => (
          <article class:list={[
            'research-node',
            `research-node--${item.title === 'Human-AI Continuity' ? 'core' : `satellite-${index + 1}`}`,
          ]}>
            <div class="research-node__status"><i></i><span>{item.status}</span></div>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            <ul>
              {item.constraints.map((constraint) => <li><span aria-hidden="true"></span>{constraint}</li>)}
            </ul>
            <span class="research-node__corner" aria-hidden="true"></span>
          </article>
        ))}
      </div>
    </section>

    <section id="contact" class="section-shell ultra-section ultra-section--contact" data-section="contact">
      <ContactCTA />
    </section>
  </main>

  <Footer />

  <script is:inline>
    document.documentElement.classList.add('motion-ready');

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealNodes = document.querySelectorAll('.reveal');

    if (reduced || !('IntersectionObserver' in window)) {
      revealNodes.forEach((node) => node.classList.add('reveal-visible'));
    } else {
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('reveal-visible');
          if (entry.target.hasAttribute('data-process-system')) {
            entry.target.classList.add('is-running');
          }
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.16, rootMargin: '0px 0px -8% 0px' });

      revealNodes.forEach((node) => revealObserver.observe(node));
    }

    const navLinks = Array.from(document.querySelectorAll('[data-nav-section]'));
    const sections = Array.from(document.querySelectorAll('[data-section]')).filter((section) => section.id);

    if ('IntersectionObserver' in window) {
      const sectionObserver = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        navLinks.forEach((link) => {
          link.classList.toggle('is-active', link.getAttribute('data-nav-section') === visible.target.id);
        });
      }, { threshold: [0.18, 0.35, 0.55], rootMargin: '-18% 0px -54% 0px' });
      sections.forEach((section) => sectionObserver.observe(section));
    }

    const root = document.documentElement;
    let scrollFrame = 0;
    const updateScroll = () => {
      scrollFrame = 0;
      const scrollable = Math.max(1, root.scrollHeight - window.innerHeight);
      root.style.setProperty('--page-progress', String(Math.min(1, window.scrollY / scrollable)));
    };
    window.addEventListener('scroll', () => {
      if (!scrollFrame) scrollFrame = requestAnimationFrame(updateScroll);
    }, { passive: true });
    updateScroll();

    if (!reduced) {
      const heroStage = document.querySelector('[data-hero-stage]');
      if (heroStage instanceof HTMLElement) {
        heroStage.addEventListener('pointermove', (event) => {
          const rect = heroStage.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width;
          const y = (event.clientY - rect.top) / rect.height;
          heroStage.style.setProperty('--ry', `${(x - 0.5) * 24}deg`);
          heroStage.style.setProperty('--rx', `${(0.5 - y) * 20}deg`);
          heroStage.style.setProperty('--mx', `${x * 100}%`);
          heroStage.style.setProperty('--my', `${y * 100}%`);
        });
        heroStage.addEventListener('pointerleave', () => {
          heroStage.style.setProperty('--ry', '0deg');
          heroStage.style.setProperty('--rx', '0deg');
          heroStage.style.setProperty('--mx', '50%');
          heroStage.style.setProperty('--my', '45%');
        });
      }

      document.querySelectorAll('.tilt-surface').forEach((surface) => {
        if (!(surface instanceof HTMLElement)) return;
        surface.addEventListener('pointermove', (event) => {
          const rect = surface.getBoundingClientRect();
          surface.style.setProperty('--glow-x', `${event.clientX - rect.left}px`);
          surface.style.setProperty('--glow-y', `${event.clientY - rect.top}px`);
        });
      });
    }

    document.querySelectorAll('.site-nav__menu-panel a').forEach((link) => {
      link.addEventListener('click', () => {
        const menu = link.closest('details');
        if (menu) menu.removeAttribute('open');
      });
    });
  </script>
</BaseLayout>
