---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from '../components/layout/TopNav.astro';
import Footer from '../components/layout/Footer.astro';
import SectionHeading from '../components/sections/SectionHeading.astro';
import HeroBanner from '../components/sections/HeroBanner.astro';
import CapabilityGrid from '../components/sections/CapabilityGrid.astro';
import ProcessSection from '../components/sections/ProcessSection.astro';
import ProofSection from '../components/sections/ProofSection.astro';
import ContactCTA from '../components/sections/ContactCTA.astro';
import { siteCopy } from '../data/siteData';
---

<BaseLayout
  title="Malone Integrated Tech | Integrated Assistant Systems"
  description="Integrated assistant systems for people and small businesses. Practical AI integration, continuity, and systems support."
  currentPath="/"
>
  <TopNav />

  <main class="space-y-24 pb-20">
    <section class="section-shell pt-8 lg:pt-12">
      <HeroBanner />
    </section>

    <section id="what-we-build" class="section-shell">
      <SectionHeading
        title="What We Build"
        heading="Capture -> Context -> Tools -> Action -> Continuity"
        description="No generic assistant layer. We build systems tuned to your existing process, then harden the interfaces."
      />
      <CapabilityGrid items={siteCopy.capabilities} />
    </section>

    <section id="how-it-works" class="section-shell">
      <SectionHeading
        title="How It Works"
        heading="Capture -> Context -> Tools -> Action -> Continuity"
        description="A practical flow from signal to sustained execution."
      />
      <ProcessSection steps={siteCopy.process} />
    </section>

    <section id="research" class="section-shell">
      <SectionHeading
        title="Research & Development"
        heading="Capture -> Context -> Tools -> Action -> Continuity"
        description="Distinct from commercial operations until outcomes are validated."
      />
      <div class="grid gap-5 md:grid-cols-2">
        {siteCopy.research.map((item) => (
          <article class="card-panel reveal">
            <p class="chip">Phase: {item.status}</p>
            <h3 class="mt-2 text-xl text-white font-semibold">{item.title}</h3>
            <p class="mt-2 text-sm text-muted">{item.summary}</p>
            <ul class="mt-3 space-y-1 text-sm text-slate-300">
              {item.constraints.map((constraint) => (
                <li class="pl-4 relative">
                  <span class="absolute left-0 top-2 h-1.5 w-1.5 rounded-full bg-signal"></span>
                  {constraint}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="proof" class="section-shell">
      <SectionHeading
        title="Current Work"
        heading="Capture -> Context -> Tools -> Action -> Continuity"
        description="Representative systems, prototypes, and integration patterns under review."
      />
      <ProofSection items={siteCopy.proof} />
    </section>

    <section id="contact" class="section-shell">
      <ContactCTA />
    </section>
  </main>

  <Footer />

  <script is:inline>
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduced) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
          }
        }
      }, { threshold: 0.2 });

      document.querySelectorAll('.reveal').forEach((node) => observer.observe(node));
    } else {
      document.querySelectorAll('.reveal').forEach((node) => node.classList.add('reveal-visible'));
    }
  </script>
</BaseLayout>

