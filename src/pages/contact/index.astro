---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNav from '../../components/layout/TopNav.astro';
import Footer from '../../components/layout/Footer.astro';
import SectionHeading from '../../components/sections/SectionHeading.astro';
import ContactForm from '../../components/sections/ContactForm.astro';
---

<BaseLayout
  title="Contact | Malone Integrated Tech"
  description="Request a project intake and start an assistant systems conversation."
  currentPath="/contact"
>
  <TopNav />
  <main class="section-shell pt-24">
    <SectionHeading
      title="Contact"
      heading="Start with a practical scope conversation"
      description="Share current workflows, current tools, and target outcome so we can propose an implementation path."
    />
    <div class="grid gap-6 lg:grid-cols-[1.1fr_.9fr]">
      <ContactForm />
      <aside class="card-panel reveal">
        <h2 class="text-2xl font-semibold text-white">Contact path</h2>
        <p class="mt-3 text-muted">Backend and provider integrations are intentionally abstracted during this phase.</p>
        <p class="mt-4 text-muted">Mailbox: <a href="mailto:curtis@maloneintegratedtech.com" class="underline">curtis@maloneintegratedtech.com</a></p>
        <p class="mt-4 text-sm text-slate-300">
          You can connect email routing and CRM targets once the operational channel policy is approved.
        </p>
      </aside>
    </div>
  </main>
  <Footer />
</BaseLayout>
