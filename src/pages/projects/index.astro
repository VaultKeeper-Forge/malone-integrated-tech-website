---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNav from '../../components/layout/TopNav.astro';
import Footer from '../../components/layout/Footer.astro';
import SectionHeading from '../../components/sections/SectionHeading.astro';
import FeaturedWorkFeature from '../../components/ui/FeaturedWorkFeature.astro';
import { featuredWork, siteCopy } from '../../data/siteData';
import { track } from '../../lib/analytics';

track({ action: 'view_projects_page' });
---

<BaseLayout
  title="Current Work and Proof | Malone Integrated Tech"
  description="Current client work, owner-operated systems, and research prototypes from Malone Integrated Tech, with honest status and scope boundaries."
  currentPath="/projects"
>
  <TopNav />
  <main class="section-shell page-main">
    <SectionHeading
      level={1}
      title="Current Work"
      heading="Proof with the labels left on"
      description="See current client work, owner-operated systems, and research prototypes separated by status and scope."
    />
    {featuredWork.map((work) => <FeaturedWorkFeature work={work} />)}
    <div class="content-card-grid content-card-grid--two">
      {siteCopy.proof.map((project) => (
        <article class="card-panel reveal">
          <div class="chip-row">
            <span class="chip">Status: {project.status}</span>
            {project.tags.map((tag) => <span class="chip">{tag}</span>)}
          </div>
          <h2 class="detail-card__title">{project.title}</h2>
          <p class="detail-card__summary">{project.summary}</p>
          <p class="detail-card__outcome"><strong>Outcome:</strong> {project.outcome}</p>
        </article>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>

