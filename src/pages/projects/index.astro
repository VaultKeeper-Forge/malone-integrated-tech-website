---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNav from '../../components/layout/TopNav.astro';
import Footer from '../../components/layout/Footer.astro';
import SectionHeading from '../../components/sections/SectionHeading.astro';
import { siteCopy } from '../../data/siteData';
import { track } from '../../lib/analytics';

track({ action: 'view_projects_page' });
---

<BaseLayout
  title="Projects and Proof | Malone Integrated Tech"
  description="Sample project and proof set for Malone Integrated Tech with status, constraints, and outcomes."
  currentPath="/projects"
>
  <TopNav />
  <main class="section-shell pt-24">
    <SectionHeading
      title="Projects & Proof"
      heading="Representative proof with explicit status"
      description="Research prototypes and production-ready examples are separated. Status markers are visible by default. Current entries are sample frameworks pending client permissioned releases."
    />
    <div class="grid gap-5 md:grid-cols-2">
      {siteCopy.proof.map((project) => (
        <article class="card-panel reveal">
          <div class="flex flex-wrap gap-2">
            <span class="chip">Status: {project.status}</span>
            {project.tags.map((tag) => <span class="chip">{tag}</span>)}
          </div>
          <h2 class="mt-3 text-2xl font-semibold text-white">{project.title}</h2>
          <p class="mt-2 text-muted">{project.summary}</p>
          <p class="mt-3 text-sm text-slate-200"><strong>Outcome:</strong> {project.outcome}</p>
        </article>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
