---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopNav from '../../components/layout/TopNav.astro';
import Footer from '../../components/layout/Footer.astro';
import SectionHeading from '../../components/sections/SectionHeading.astro';
import { siteCopy } from '../../data/siteData';
import { track } from '../../lib/analytics';

track({ action: 'view_projects_page' });
---

<BaseLayout
  title="AI Systems Projects and Proof | Malone Integrated Tech"
  description="Representative AI assistant, workflow integration, and continuity-system projects with honest status, constraints, and outcomes."
  currentPath="/projects"
>
  <TopNav />
  <main class="section-shell page-main">
    <SectionHeading
      level={1}
      title="Projects & Proof"
      heading="Representative proof with explicit status"
      description="Research prototypes and production-ready examples are separated by stage. Status markers are visible by default across every entry."
    />
    <div class="content-card-grid content-card-grid--two">
      {siteCopy.proof.map((project) => (
        <article class="card-panel reveal">
          <div class="chip-row">
            <span class="chip">Status: {project.status}</span>
            {project.tags.map((tag) => <span class="chip">{tag}</span>)}
          </div>
          <h2 class="detail-card__title">{project.title}</h2>
          <p class="detail-card__summary">{project.summary}</p>
          <p class="detail-card__outcome"><strong>Outcome:</strong> {project.outcome}</p>
        </article>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>

